{
  "target": "./canonical-draft6.json",
  "tests": [
    {
      "description": "Boolean true is canonical",
      "valid": true,
      "data": true
    },
    {
      "description": "Boolean false is canonical",
      "valid": true,
      "data": false
    },
    {
      "description": "A graph with one node is canonical",
      "valid": true,
      "data": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "allOf": [
          {
            "$ref": "#/definitions/0"
          }
        ],
        "definitions": {
          "0": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "A node that no instance satisfies is canonical",
      "valid": true,
      "data": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "allOf": [
          {
            "$ref": "#/definitions/0"
          }
        ],
        "definitions": {
          "0": {
            "additionalProperties": {
              "$ref": "#/definitions/1"
            }
          },
          "1": false
        }
      }
    },
    {
      "description": "A string value is rejected",
      "valid": false,
      "data": "not a schema"
    },
    {
      "description": "A document without a graph is rejected",
      "valid": false,
      "data": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "type": "string"
      }
    },
    {
      "description": "A document without entries is rejected",
      "valid": false,
      "data": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "allOf": [
          {
            "$ref": "#/definitions/0"
          }
        ]
      }
    },
    {
      "description": "A conjunction of two edges is rejected",
      "valid": false,
      "data": {
        "$schema": "http://json-schema.org/draft-06/schema#",
        "allOf": [
          {
            "$ref": "#/definitions/0"
          },
          {
            "$ref": "#/definitions/1"
          }
        ],
        "definitions": {
          "0": true,
          "1": true
        }
      }
    }
  ]
}

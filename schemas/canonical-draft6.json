{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:sourcemeta.com,2026:canonical:draft6",
  "title": "Canonical JSON Schema Draft 6",
  "description": "Meta-schema that validates whether a given JSON Schema Draft 6 document is in canonical graph form",
  "examples": [
    true,
    {
      "$schema": "http://json-schema.org/draft-06/schema#",
      "allOf": [
        {
          "$ref": "#/definitions/0"
        }
      ],
      "definitions": {
        "0": {
          "type": "string"
        }
      }
    }
  ],
  "anyOf": [
    {
      "$ref": "#/$defs/document"
    },
    {
      "type": "boolean"
    }
  ],
  "$defs": {
    "document": {
      "x-lint-exclude": "simple_properties_identifiers",
      "type": "object",
      "required": [ "allOf", "definitions" ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "allOf": {
          "type": "array",
          "maxItems": 1,
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "definitions": {
          "type": "object"
        }
      }
    },
    "edge": {
      "x-lint-exclude": "simple_properties_identifiers",
      "type": "object",
      "required": [ "$ref" ],
      "properties": {
        "$ref": {
          "type": "string"
        }
      }
    }
  }
}
